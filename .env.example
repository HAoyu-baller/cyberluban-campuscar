# Copy to .env for local development. Never commit the real .env file.

# NUC web control
CONTROL_TOKEN=replace-with-a-random-token
ROS_COMMAND_TOKEN=replace-with-a-random-token
VISION_SPRAY_TOKEN=replace-with-a-random-token

# Serial control
SERIAL_PORT=auto
SERIAL_BAUD=115200

# Network services
WEB_HOST=0.0.0.0
WEB_PORT=8000
ROSBRIDGE_ADDRESS=0.0.0.0
ROSBRIDGE_PORT=9090
