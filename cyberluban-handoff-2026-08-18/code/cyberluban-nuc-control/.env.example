# ESP32 USB serial port. Use auto first; set /dev/ttyUSB0 or /dev/ttyACM0
# when the NUC has more than one serial device. Use mock for UI-only testing.
SERIAL_PORT=auto
SERIAL_BAUD=115200
SERIAL_RECONNECT_SECONDS=2.0
SERIAL_BOOT_SECONDS=2.0

WEB_HOST=0.0.0.0
WEB_PORT=8000

# The installer generates a random token. For manual setup, replace this.
CONTROL_TOKEN=CHANGE_ME

# Browser must report desired state faster than this timeout.
CLIENT_TIMEOUT_SECONDS=0.8
DRIVE_REFRESH_SECONDS=0.15
SPRAY_REFRESH_SECONDS=0.4
