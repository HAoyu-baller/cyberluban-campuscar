<?xml version="1.0"?>
<package format="3">
  <name>campuscar_lidar_bringup</name>
  <version>0.1.0</version>
  <description>Vehicle-frame bringup for the Livox Mid-360 on the campus car.</description>
  <maintainer email="haoyu@todo.todo">haoyu</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
